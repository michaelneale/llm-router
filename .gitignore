# ---------------------------------------------------------------------------
# Project-specific: keep the *recipe*, not the private inputs/outputs.
#
# We share the code, configs, and scripts that let someone build their OWN
# personalized router from their OWN goose sessions. We do NOT ship:
#   - training data derived from private session history (prompts, file paths,
#     repo names, anything you actually typed to goose)
#   - large trained checkpoints (binary weights; 15-21 MB each)
# ---------------------------------------------------------------------------

# Training/eval data derived from personal goose session history.
# Contains real prompts, paths, repo & PR references — do not publish.
data/

# Trained router checkpoints (large binaries; personal/benchmark-specific).
# Regenerate with `model-router train` or distribute out-of-band (see README).
checkpoints/*.pt
checkpoints/*.pkl

# Generated LiteLLM config (derived from goose-mix.yaml via config_bridge).
# Regenerate with `model-router generate-litellm-config`; uncomment to ignore.
# configs/litellm-goose.yaml

# SWE-bench training data + cache (large, regenerable via scripts/pull_swebench_traces.py)
data/swebench-train*.csv
data_public/
checkpoints/*.pt
checkpoints/split/
data/combined-train*.csv
data/full-train*.csv
checkpoints/combined*/
checkpoints/full*/
