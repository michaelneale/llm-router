# ---------------------------------------------------------------------------
# Project-specific: keep the recipe, not generated inputs/outputs.
#
# We share code, configs, and scripts. We do not ship generated datasets,
# telemetry, large model checkpoints, or local experiment outputs.
# ---------------------------------------------------------------------------

# Generated training/eval data. Some local workflows may include private prompts
# or paths, and public trace exports are large/regenerable.
data/

# Trained router checkpoints (large binaries; benchmark/model-pool-specific).
# Regenerate with `model-router train` or distribute out-of-band (see README).
checkpoints/*.pt
checkpoints/*.pkl

# Generated LiteLLM configs. Regenerate from the active pool config.
# Regenerate with `model-router generate-litellm-config`; uncomment to ignore.
# configs/litellm-combined.yaml

# SWE-bench training data + cache (large, regenerable via scripts/pull_swebench_traces.py)
data/swebench-train*.csv
data_public/
checkpoints/*.pt
checkpoints/split/
data/combined-train*.csv
data/full-train*.csv
checkpoints/combined*/
checkpoints/full*/
